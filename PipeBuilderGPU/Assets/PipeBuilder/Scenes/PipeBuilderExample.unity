  m_CompilationContext:
    serializedVersion: 2
    buildTarget:
      platform: 19
      subTarget: 2
      extendedPlatform: 0
      isEditor: 0
    platformGroup: 1
    sourceFileName: PipeCompute.compute
    source: "#include \"MathForPipe.hlsl\"\n\n#pragma kernel CalculateStraightVertices\n#pragma
      kernel SetStraightTriangles\n#pragma kernel CalculateConnectionsSegments\n#pragma
      kernel CalculateCircleSegments\n#pragma kernel CalculateConnectionsVertices\n#pragma
      kernel SetDefaultNearestVertices\n#pragma kernel PreventTwisting\n#pragma kernel
      SetConnectionsTriangles\n#pragma kernel SetEndCapsTriangles\n\ncbuffer _constantsBuffer\n{\n   
      // x -> radius; y -> connection offset; z -> max float value\n    float3 rad_conOff_maxFV;\n   
      \n    int facesCount;\n    \n    int straightSegmentsCount;\n    int connectionSegmentsCount;\n   
      int connectionBeltsCount;\n};\n\nint preventTwistingIteration;\n\nStructuredBuffer<CircleVertices>
      _straightSegmentsPointsBuffer;\nStructuredBuffer<ConnectionSegmentPoints> _connectionSegmentsPointsBuffer;\n\nRWStructuredBuffer<ConnectionSegment>
      _connectionSegmentsBuffer;\nRWStructuredBuffer<CircleSegment> _circleSegmentsBuffer;\nRWStructuredBuffer<NearestConnectionVertex>
      _connectionsNearestVerticesBuffer;\n\nRWStructuredBuffer<float3> _verticesBuffer;\nRWStructuredBuffer<float3>
      _normalsBuffer;\nRWStructuredBuffer<int> _trianglesBuffer;\n\n/////////////////////////////////////////////////////////////////////\n//
      CALCULATIONS OF STRAIGHT PIPE SEGMENTS:\n\n// Calculate the positions of the
      vertices of straight pipe segments\n// id.x -> count of straight pipe segments\n//
      id.y -> count of faces\n[numthreads(2,1,1)]\nvoid CalculateStraightVertices
      (uint3 id : SV_DispatchThreadID)\n{ \n    int index = id.x * facesCount + id.y;\n   
      \n\tfloat angle = radians(360.0 / facesCount);\n    \n    Axes axes = GetCirclesAxes(_straightSegmentsPointsBuffer[id.x].direction);\n\t\n   
      float3 currentVertex = _straightSegmentsPointsBuffer[id.x].center +\n       
      (rad_conOff_maxFV.x * cos(angle * id.y) * axes.xAxis) +\n        (rad_conOff_maxFV.x
      * sin(angle * id.y) * axes.yAxis);\n    \n    float3 normal = normalize(currentVertex
      - _straightSegmentsPointsBuffer[id.x].center);\n\t\n    _verticesBuffer[index]
      = currentVertex;\n    _normalsBuffer[index] = normal;\n}\n\n// Set the indexes
      of polygons of straight pipe segments\n// id.x -> count of straight pipe segments\n//
      id.y -> count of faces\n[numthreads(1,1,1)]\nvoid SetStraightTriangles (uint3
      id : SV_DispatchThreadID)\n{\n\tint verticesOffset = id.x * facesCount * 2;\n\tint
      trianglesOffset = facesCount * id.x * 6 + id.y * 6;\n    \n    _trianglesBuffer[trianglesOffset]
      = (verticesOffset + id.y);\n    _trianglesBuffer[trianglesOffset + 1] = (verticesOffset
      + (id.y + 1) % facesCount);\n    _trianglesBuffer[trianglesOffset + 2] = (verticesOffset
      + id.y + facesCount);\n    \n    _trianglesBuffer[trianglesOffset + 3] = (verticesOffset
      + (id.y + 1) % facesCount + facesCount);\n    _trianglesBuffer[trianglesOffset
      + 4] = (verticesOffset + id.y + facesCount);\n    _trianglesBuffer[trianglesOffset
      + 5] = (verticesOffset + (id.y + 1) % facesCount);\n    \n}\n\n// END CALCULATIONS
      OF STRAIGHT PIPE SEGMENTS\n\n/////////////////////////////////////////////////////////////////////\n//
      CALCULATIONS OF PIPE CONNECTION SEGMENTS:\n\n// Calculate pipe connection segments\n//
      id.x -> count of connection pipe segments\n[numthreads(1,1,1)]\nvoid CalculateConnectionsSegments
      (uint3 id : SV_DispatchThreadID)\n{\n    float3 startOffset = normalize(_connectionSegmentsPointsBuffer[id.x].center
      - _connectionSegmentsPointsBuffer[id.x].start) * rad_conOff_maxFV.y;\n    float3
      endOffset = normalize(_connectionSegmentsPointsBuffer[id.x].end - _connectionSegmentsPointsBuffer[id.x].center)
      * rad_conOff_maxFV.y;\n\n    float3 startPoint = _connectionSegmentsPointsBuffer[id.x].center
      - startOffset;\n    float3 endPoint = _connectionSegmentsPointsBuffer[id.x].center
      + endOffset;\n\n\tfloat3 torusCenter = GetTorusCenter(startPoint, startOffset,
      endPoint, endOffset);\n    \n    float actualTorusRadius = length(torusCenter
      - startPoint);\n\n\tTorusSegment torusSegment;\n\n\ttorusSegment.torusCenter
      = torusCenter;\n\ttorusSegment.torusRadius = actualTorusRadius;\n\n\tfloat3
      xAxis = normalize(startPoint - torusCenter);\n\tfloat3 yAxis = normalize(endPoint
      - torusCenter);\n\n\tfloat angle = GetTorusAngle(xAxis, yAxis);\n    float
      radianPerSegment = angle / connectionBeltsCount;\n\n\tConnectionSegment segment;\n\n   
      segment.axes = OrthoNormalize(xAxis, yAxis);\n\tsegment.torusSegment = torusSegment;\n\tsegment.radianPerSegment
      = radianPerSegment;\n\n    _connectionSegmentsBuffer[id.x] = segment;\n}\n\n//
      Returns the center of the circle of vertices of the pipe connection\nfloat3
      CalculateCircleCenter(int connectionSegmendID, int connectionBeltID)\n{\n\tfloat3
      x = _connectionSegmentsBuffer[connectionSegmendID].torusSegment.torusRadius
      *\n        cos(_connectionSegmentsBuffer[connectionSegmendID].radianPerSegment
      * connectionBeltID) *\n        _connectionSegmentsBuffer[connectionSegmendID].axes.xAxis;\n   
      \n    float3 y = _connectionSegmentsBuffer[connectionSegmendID].torusSegment.torusRadius
      * \n        sin(_connectionSegmentsBuffer[connectionSegmendID].radianPerSegment
      * connectionBeltID) * \n        _connectionSegmentsBuffer[connectionSegmendID].axes.yAxis;\n\n   
      return _connectionSegmentsBuffer[connectionSegmendID].torusSegment.torusCenter
      + x + y;\n}\n\n// Calculate the segment of the circle of vertices of the pipe
      connection\nvoid CalculateCircleSegment(int connectionSegmendID, int connectionBeltID)\n{\n   
      int index = (connectionSegmendID * connectionBeltsCount + connectionBeltID)
      - (connectionSegmendID + 1);\n    \n    float3 circleCenter = CalculateCircleCenter(connectionSegmendID,
      connectionBeltID);\n\n    float3 previosCircleCenter = CalculateCircleCenter(connectionSegmendID,
      connectionBeltID - 1);\n\n\tCircleSegment circleSegment;\n\n\tcircleSegment.center
      = circleCenter;\n\n    circleSegment.axes = GetCirclesAxes(normalize(circleCenter
      - previosCircleCenter));\n\n    _circleSegmentsBuffer[index] = circleSegment;\n}\n\n//
      Calculate the segments of the circle of vertices of the pipe connection segments\n//
      id.x -> count of connection pipe segments\n// id.y -> count of connection belts
      for 1 connection pipe segment\n[numthreads(1,1,1)]\nvoid CalculateCircleSegments
      (uint3 id : SV_DispatchThreadID)\n{\n    if (id.y != 0)\n        CalculateCircleSegment(id.x,
      id.y);\n}\n\n// Calculate the vertices of the pipe connections segments\n//
      id.x -> count of circles of vertices for all connection pipe segments\n// id.y
      -> count of faces\n[numthreads(1,1,1)]\nvoid CalculateConnectionsVertices (uint3
      id : SV_DispatchThreadID)\n{\n    int straightVerticesOffset = facesCount *
      2 * straightSegmentsCount;\n    int index = straightVerticesOffset + id.x *
      facesCount + id.y;\n    \n\tfloat angle = radians(360.0 / facesCount);\n\n\tfloat3
      x = rad_conOff_maxFV.x * cos(angle * id.y) * _circleSegmentsBuffer[id.x].axes.xAxis;\n   
      float3 y = rad_conOff_maxFV.x * sin(angle * id.y) * _circleSegmentsBuffer[id.x].axes.yAxis;\n\n   
      float3 currentVertex = _circleSegmentsBuffer[id.x].center + x + y;\n\t\n   
      float3 normal = normalize(currentVertex - _circleSegmentsBuffer[id.x].center);\n   
      \n    _verticesBuffer[index] = currentVertex;\n    _normalsBuffer[index] =
      normal;\n}\n\n// Set the nearest vertices by default\n// id.x -> count of connection
      pipe segments\n// id.y -> count of connection belts for 1 connection pipe segment\n//
      id.z -> count of faces\n[numthreads(1, 1, 1)]\nvoid SetDefaultNearestVertices
      (uint3 id : SV_DispatchThreadID)\n{\n    int index = id.x * connectionBeltsCount
      * facesCount + id.y * facesCount + id.z;\n    \n    NearestConnectionVertex
      newNearestVertex;\n\t\t\n    newNearestVertex.vertexIndex = 0;\n    newNearestVertex.distance
      = rad_conOff_maxFV.z;\n    \n    _connectionsNearestVerticesBuffer[index] =
      newNearestVertex;\n}\n\n// Prevent twisting on the pipe connections segments\n//
      id.x -> count of connection pipe segments\n// id.y -> count of connection belts
      for 1 connection pipe segment\n// id.z -> count of faces\n[numthreads(1,1,1)]\nvoid
      PreventTwisting(uint3 id : SV_DispatchThreadID)\n{\n    int nearestVertexIndex
      = id.x * connectionBeltsCount * facesCount + id.y * facesCount + id.z;\n   
      \n    int straightVerticesOffset = facesCount * 2 * straightSegmentsCount;\n   
      int circlesCount = connectionBeltsCount - 1;\n    \n    int isYzero = id.y
      == 0;\n    int isYcircleCount = id.y == circlesCount;\n    int isYdefault =
      id.y != 0 && id.y != circlesCount;\n    \n    int startOffset1 = facesCount
      + 2 * facesCount * id.x;\n    int endOffset1 = straightVerticesOffset + circlesCount
      * facesCount * id.x;\n    \n    int startOffset2 = straightVerticesOffset +
      (facesCount * (circlesCount - 1) + (facesCount * circlesCount * id.x));\n   
      int endOffset2 = facesCount * 2 + facesCount * 2 * id.x;\n    \n    int endOffset3
      = straightVerticesOffset + id.y * facesCount + (facesCount * circlesCount *
      id.x);\n    int startOffset3 = endOffset3 - facesCount;\n    \n    int startOffset
      = startOffset1 * isYzero + startOffset2 * isYcircleCount + startOffset3 * isYdefault;\n   
      int endOffset = endOffset1 * isYzero + endOffset2 * isYcircleCount + endOffset3
      * isYdefault;\n    \n    int currentVerticesIndex = startOffset + id.z;\n   
      int nextVerticesIndex = endOffset + preventTwistingIteration;\n\t\n    float
      currentDistance = distance(_verticesBuffer[currentVerticesIndex], _verticesBuffer[nextVerticesIndex]);\n   
      \n    NearestConnectionVertex nearestVertex = _connectionsNearestVerticesBuffer[nearestVertexIndex];\n   
      \n    int isMinDistance = currentDistance < nearestVertex.distance;\n    \n   
      nearestVertex.vertexIndex = isMinDistance * nextVerticesIndex + Inverse(isMinDistance)
      * nearestVertex.vertexIndex;\n    nearestVertex.distance = isMinDistance *
      currentDistance + Inverse(isMinDistance) * nearestVertex.distance;\n    \n   
      _connectionsNearestVerticesBuffer[nearestVertexIndex] = nearestVertex;\n}\n\n//
      Generate a quad of pipe connection polygons\nvoid GenerateConnectionQuad(int
      startOffset, int endOffset, int currentFace, int trianglesOffset)\n{  \n   
      int zeroOrOne = any(facesCount - (currentFace + 1));\n    int interimCalc =
      1 - zeroOrOne * facesCount;\n    int next = interimCalc - sign(interimCalc)
      * facesCount;\n    \n    _trianglesBuffer[trianglesOffset] = startOffset +
      currentFace;\n    _trianglesBuffer[trianglesOffset + 1] = startOffset + (currentFace
      + 1) % facesCount;\n    _trianglesBuffer[trianglesOffset + 2] = _connectionsNearestVerticesBuffer[endOffset].vertexIndex;\n   
      \n    _trianglesBuffer[trianglesOffset + 3] = _connectionsNearestVerticesBuffer[endOffset
      + next].vertexIndex;\n    _trianglesBuffer[trianglesOffset + 4] = _connectionsNearestVerticesBuffer[endOffset].vertexIndex;\n   
      _trianglesBuffer[trianglesOffset + 5] = startOffset + (currentFace + 1) % facesCount;\n}\n\n//
      Set the indexes of polygons of pipe connections segments\n// id.x -> count
      of connection pipe segments\n// id.y -> count of connection belts for 1 connection
      pipe segment\n// id.z -> count of faces\n[numthreads(1, 1, 1)]\nvoid SetConnectionsTriangles(uint3
      id : SV_DispatchThreadID)\n{\n    int straightVerticesOffset = facesCount *
      2 * straightSegmentsCount;\n    int straightTrianglesOffset = straightSegmentsCount
      * facesCount * 6;\n    int trianglesOffset = straightTrianglesOffset + id.x
      * connectionBeltsCount * facesCount * 6 + id.y * facesCount * 6 + id.z * 6;\n   
      \n    int nearestVertexIndex = id.x * connectionBeltsCount * facesCount + id.y
      * facesCount + id.z;\n    int circlesCount = connectionBeltsCount - 1;\n   
      \n    int isYzero = id.y == 0;\n    int isYcircleCount = id.y == circlesCount;\n   
      int isYdefault = id.y != 0 && id.y != circlesCount;\n    \n    int startOffset1
      = facesCount + 2 * facesCount * id.x;\n    int startOffset2 = straightVerticesOffset
      + (facesCount * (circlesCount - 1) + (facesCount * circlesCount * id.x));\n   
      int startOffset3 = (straightVerticesOffset + id.y * facesCount + (facesCount
      * circlesCount * id.x)) - facesCount;\n    \n    int startOffset = startOffset1
      * isYzero + startOffset2 * isYcircleCount + startOffset3 * isYdefault;\n   
      \n    GenerateConnectionQuad(startOffset, nearestVertexIndex, id.z, trianglesOffset);\n}\n\n//
      END CALCULATIONS OF PIPE CONNECTION SEGMENTS\n/////////////////////////////////////////////////////////////////////\n\n//
      Set the indexes of polygons of pipe end caps\n// id.x -> (count of faces) -
      2\n[numthreads(1, 1, 1)]\nvoid SetEndCapsTriangles(uint3 id : SV_DispatchThreadID)\n{\n   
      int endCircleOffset = straightSegmentsCount * facesCount * 2 - facesCount;\n   
      \n    int straightTrianglesOffset = straightSegmentsCount * facesCount * 6;\n   
      int connectionTrianglesOffset = connectionSegmentsCount * connectionBeltsCount
      * facesCount * 6;\n    \n    int startTrianglesIndex = id.x * 3 + straightTrianglesOffset
      + connectionTrianglesOffset;\n    int endTrianglesIndex = id.x * 3 + (facesCount
      - 2) * 3 + straightTrianglesOffset + connectionTrianglesOffset;\n\n    _trianglesBuffer[startTrianglesIndex]
      = 0;\n    _trianglesBuffer[startTrianglesIndex + 1] = id.x + 2;\n    _trianglesBuffer[startTrianglesIndex
      + 2] = id.x + 1;\n    \n    _trianglesBuffer[endTrianglesIndex] = endCircleOffset;\n   
      _trianglesBuffer[endTrianglesIndex + 1] = endCircleOffset + id.x + 1;\n   
      _trianglesBuffer[endTrianglesIndex + 2] = endCircleOffset + id.x + 2;\n}"
